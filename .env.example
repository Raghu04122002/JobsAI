# Shared
TZ=UTC

# Database
# Production (Render): set DATABASE_URL to the Supabase *session pooler* URL (port 5432).
# The direct connection is IPv6-only and unreachable from Render; don't use the
# transaction pooler (6543). Never commit the real password.
# DATABASE_URL=postgresql://postgres.<project-ref>:<YOUR-PASSWORD>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# Local dev (docker-compose): leave DATABASE_URL unset; the POSTGRES_* values below
# point at the local "db" container.
POSTGRES_DB=career_copilot
POSTGRES_USER=career
POSTGRES_PASSWORD=career
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=replace-with-secure-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# OpenAI + Chroma
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PERSIST_DIR=/app/chroma_data

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost/api
